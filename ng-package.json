{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "./dist/jp-shared",
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*.scss",
      "output": "styles"
    },
    "./CHANGELOG.md"
  ],
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "src/styles"
    ]
  }
}
